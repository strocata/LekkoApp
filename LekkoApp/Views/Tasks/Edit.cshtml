@model LekkoApp.Models.Task

<div class="col-12 col-lg-6">
    <div class="card">
        <div class="card-header">
            <div class="card-title">
                Task <span class="text-muted">#@Model.TaskNumber</span>
            </div>
        </div>

        <div class="card-body">
            <!-- Save Form -->
            <form asp-controller="Tasks" asp-action="UpdateCardTask" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<LekkoApp.Models.Enums.TaskStatus>()"
                            class="form-select">
                        <option value="">Select status</option>
                    </select>
                    <span asp-validation-for="Status" class="invalid-feedback d-block"></span>
                </div>

                <!-- Meta info -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6">
                        <div class="border rounded p-3 h-100">
                            <div class="text-secondary mb-1">Created</div>
                            <div class="font-monospace text-muted">
                                @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-sm-3">
                        <div class="border rounded p-3 h-100 text-center">
                            <div class="text-secondary mb-1">Estimated</div>
                            <div class="h2 m-0">@Model.EstimatedPomodoros</div>
                        </div>
                    </div>

                    <div class="col-6 col-sm-3">
                        <div class="border rounded p-3 h-100 text-center">
                            <div class="text-secondary mb-1">Completed</div>
                            <div class="h2 m-0">@Model.CompletedPomodoros</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save changes
                    </button>
                </div>
            </form>

            <!-- Start Timer -->
            <form asp-controller="Tasks" asp-action="StartTimer" method="post" class="mt-3">
                <input type="hidden" name="taskId" value="@Model.Id" />
                <button type="submit" class="btn btn-success w-100">
                    Start Timer
                </button>
            </form>
        </div>
    </div>
</div>
