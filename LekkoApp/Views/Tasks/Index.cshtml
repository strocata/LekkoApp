@using LekkoApp.Helpers
@model LekkoApp.Models.TasksViewModel

<div class="page-body">
    <div class="container-xl">

        <!-- HEADER -->
        <div class="page-header mb-4">
            <div class="row align-items-center">
                <div class="col">
                    <h2 class="page-title">Tasks</h2>
                </div>

                <div class="col-auto ms-auto">
                    <a asp-controller="Tasks"
                       asp-action="Create"
                       class="btn btn-primary">
                        + Create task
                    </a>
                </div>
            </div>
        </div>

        <!-- TASKS TABLE -->
        <div class="card">

            <!-- FILTERS -->
            <div class="card-body border-bottom py-3">
                <div class="row g-2 align-items-center">

                    <!-- PAGE SIZE -->
                    <div class="col-auto text-secondary">
                        <form asp-action="Index" method="get" class="d-flex align-items-center">
                            Show
                            <input type="text"
                                   name="PageSize"
                                   class="form-control form-control-sm mx-2"
                                   value="@ViewData["PageSize"]"
                                   size="3">
                            entries
                        </form>
                    </div>

                    <!-- SEARCH -->
                    <div class="col-auto ms-auto text-secondary">
                        <form asp-action="Index" method="get" class="d-flex align-items-center">
                            Search:
                            <input type="text"
                                   name="SearchString"
                                   class="form-control form-control-sm ms-2"
                                   value="@ViewData["SearchString"]">
                        </form>
                    </div>

                    @if (!string.IsNullOrEmpty((string?)ViewData["SearchString"]))
                    {
                        <div class="col-auto">
                            <a asp-action="Index"
                               class="btn btn-sm btn-outline-secondary">
                                Clear
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- TABLE -->
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-striped">
                    <thead>
                    <tr>
                        <th class="w-1">
                            <input class="form-check-input m-0 align-middle" type="checkbox">
                        </th>
                        <th class="w-1">
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["TaskNumberSortParm"]">
                                No.
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["TitleSortParm"]">
                                Title
                            </a>
                        </th>
                        <th>Pomodoros</th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["CreationDateSortParm"]">
                                Created
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["DueDateSortParm"]">
                                Due
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["PrioritySortParm"]">
                                Priority
                            </a>
                        </th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>

                    <tbody>
                    @foreach (var item in Model.Tasks!)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input m-0 align-middle" type="checkbox">
                            </td>

                            <td class="text-secondary">
                                @item.TaskNumber
                            </td>

                            <td>
                                <a asp-controller="Tasks"
                                   asp-action="Edit"
                                   asp-route-taskId="@item.Id"
                                   class="text-reset fw-medium">
                                    @item.Title
                                </a>
                            </td>

                            <td>
                                @item.CompletedPomodoros
                            </td>

                            <td class="text-secondary">
                                @item.CreatedAt.ToString("yyyy-MM-dd")
                            </td>

                            <td class="text-secondary">
                                @item.DueDate?.ToString("yyyy-MM-dd")
                            </td>

                            <td class="text-secondary">
                                @item.Priority
                            </td>

                            <td>
                                <span class="badge @BadgeStyles.Get(@item.Status)">
                                    @item.Status
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm dropdown-toggle"
                                            data-bs-toggle="dropdown">
                                        Actions
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <a asp-action="Edit"
                                           asp-route-taskId="@item.Id"
                                           class="dropdown-item">
                                            Edit
                                        </a>

                                        <form asp-controller="Tasks"
                                              asp-action="StartTimer"
                                              method="post">
                                            <input type="hidden"
                                                   name="taskId"
                                                   value="@item.Id" />
                                            <button type="submit"
                                                    class="dropdown-item">
                                                Start Pomodoro
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <!-- FOOTER / PAGINATION -->
            <div class="card-footer d-flex align-items-center">
                <div class="text-secondary">
                    Showing
                    <strong>@Model.Tasks.PageElementsStart–@Model.Tasks.PageElementsEnd</strong>
                    of
                    <strong>@ViewData["NumberOfAllTasks"]</strong>
                </div>

                <div class="ms-auto">
                    @{
                        var prevDisabled = !Model.Tasks.HasPreviousPage ? "disabled" : "";
                        var nextDisabled = !Model.Tasks.HasNextPage ? "disabled" : "";
                    }

                    <a asp-action="Index"
                       asp-route-pageNumber="@(Model.Tasks.PageIndex - 1)"
                       class="btn btn-sm btn-outline-secondary @prevDisabled">
                        Previous
                    </a>

                    <a asp-action="Index"
                       asp-route-pageNumber="@(Model.Tasks.PageIndex + 1)"
                       class="btn btn-sm btn-outline-secondary @nextDisabled">
                        Next
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
