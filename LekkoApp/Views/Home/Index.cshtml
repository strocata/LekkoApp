@* Focus Mode Timer *@
<div class="px4 py-5 text-center">
    <div class="row row-cols-2 justify-content-center">
        <div class="container col-xxl-8 px-4 py-5">
            <div class="row flex-lg-row-reverse align-items-center g-5 py-5">
                <div class="col-lg-6">
                    <ul class="list-group">
                        <li class="list-group-item">Work Duration</li>
                        <li class="list-group-item">Break Duration</li>
                        <li class="list-group-item">Sessions Completed</li>
                    </ul>
                </div>
                <div class="col-lg-6">
                    <h1 class="display-5 fw-bold text-body-emphasis lh-1 mb-3">Focus Mode Timer
                    </h1>
                    <p class="lead">Manage your Pomodoro sessions.</p>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-start">

                        <button type="button"
                                class="btn btn-primary btn-lg px-4 me-md-2">Start Session
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary btn-lg px-4">Reset Timer
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Short Stat *@
<div class="px-4 py-5 text-center">
    <div class="b-example-divider"></div>
    <div class="container col-xxl-8 px-4 py-5">
