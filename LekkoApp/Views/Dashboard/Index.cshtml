@model DashboardViewModel

<div class="row row-deck row-cards">
    <div class="col-sm-6 col-lg-3">
        <div class="card">
            <div class="card-body">
                <div class="subheader">Projects</div>
                <div class="h1">@Model.TotalProjects</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card bg-success-lt">
            <div class="card-body">
                <div class="subheader">Completed Tasks</div>
                <div class="h1">@Model.CompletedTasks</div>
            </div>
        </div>
    </div>
</div>

<canvas id="tasksChart"></canvas>

<div class="card">
    <div class="card-header">
        <h3 class="card-title text-danger">Overdue tasks</h3>
    </div>
    <div class="list-group list-group-flush">
        @foreach (var t in Model.OverdueTaskList)
        {
            <a class="list-group-item">
                @t.Title
                <span class="text-muted float-end">
                    @t.DueDate?.ToString("yyyy-MM-dd")
                </span>
            </a>
        }
    </div>
</div>

<script>
    new Chart(document.getElementById('tasksChart'), {
        type: 'doughnut',
        data: {
            labels: @Json.Serialize(Model.TasksByStatus.Select(x => x.Label)),
            datasets: [{
                data: @Json.Serialize(Model.TasksByStatus.Select(x => x.Value))
            }]
        }
    });

</script>





