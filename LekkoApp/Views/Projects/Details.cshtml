@model ProjectDetailsViewModel

<div class="page-body">
    <div class="container-xl">

        <div class="page-header mb-4">
            <div class="row align-items-center">
                <div class="col">
                    <div class="page-pretitle">
                        <a href="/projects" class="text-muted">Projects</a>
                    </div>
                    <h2 class="page-title">
                        @Model.Project?.Name
                        <span class="badge bg-green-lt ms-2">Active</span>
                    </h2>
                    <div class="text-secondary">
                        MVP pomodoro app with tasks and analytics
                    </div>
                </div>

                <div class="col-auto ms-auto">
                    <div class="btn-list">
                        <button class="btn btn-outline-secondary">Pause</button>
                        <button class="btn btn-outline-success">Complete</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <div class="subheader">Project progress</div>
                        <div class="h3 mb-1">@Model.DonePomodoroCount / @Model.EstimatedPomodoroCount pomodoros</div>

                        <div class="progress">
                            <div class="progress-bar" style="width: 70%" role="progressbar"></div>
                        </div>

                        <div class="text-secondary mt-2">
                            Tasks completed: @Model.DoneTasksCount / @Model.PomodoroTasksCount
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Milestone needs to be implemented -->
        <div class="card mb-4 border-primary">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <div class="subheader text-primary">
                            Current milestone
                        </div>
                        <h3 class="card-title mb-1">
                            Pomodoro Engine
                        </h3>

                        <div class="text-secondary mb-2">
                            Due: 14 Jun
                        </div>

                        <div class="progress mb-2">
                            <div class="progress-bar bg-primary" style="width: 60%"></div>
                        </div>

                        <div class="text-secondary">
                            Tasks: 6 / 10
                        </div>
                    </div>

                    <div class="col-auto">
                        <button class="btn btn-primary">
                            Focus milestone
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title">Tasks</h3>
                <div class="card-actions">
                    <button class="btn btn-sm btn-primary">+ Add task</button>
                </div>
            </div>

            <div class="list-group list-group-flush">
                @if (Model.PomodoroTasks != null)
                {
                    foreach (var item in Model.PomodoroTasks)
                    {
                        <div class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <input class="form-check-input" type="checkbox">
                                </div>
                                <div class="col">
                                    @item.Title
                                </div>
                                <div class="col-auto">
                                    <form asp-controller="Tasks"
                                          asp-action="StartTimer"
                                          method="post">
                                        <input type="hidden" name="taskId" value="@item.Id"/>

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-primary">
                                            ▶ Pomodoro
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title">Other milestones</h3>
            </div>

            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex justify-content-between">
                    <span>Setup</span>
                    <span class="badge bg-green-lt">Completed</span>
                </div>

                <div class="list-group-item d-flex justify-content-between">
                    <span>Analytics</span>
                    <span class="badge bg-secondary-lt">Planned</span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Activity</h3>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="text-secondary">Today</div>
                        <div class="h3">5 pomodoros</div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-secondary">This week</div>
                        <div class="h3">18 pomodoros</div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-secondary">Last activity</div>
                        <div class="h3">2 hours ago</div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
