@model TimerViewModel

<!DOCTYPE html>

<html>
<head>
    <title>Timer</title>
</head>
<body>
<div class="container mt-4">
    <div class="modern-tabs mb-5">
        <ul class="nav nav-tabs" id="filledTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="pomodoro-tab" data-bs-toggle="tab" data-bs-target="#pomodoro"
                        type="button" role="tab">
                    Pomodoro
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="short-break-tab" data-bs-toggle="tab" data-bs-target="#short-break"
                        type="button" role="tab">
                    Short Break
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="long-break-tab" data-bs-toggle="tab" data-bs-target="#long-break"
                        type="button" role="tab">
                    Long Break
                </button>
            </li>
        </ul>

        <div class="tab-content mt-3" id="filledTabsContent">
            <div class="tab-pane fade show active" id="pomodoro" role="tabpanel">
                <div class="timer-container d-flex flex-column align-items-center justify-content-center">
                    <div id="pomodoro-timer" class="timer-display mb-4">00:00</div>
                    <div class="btn-group">
                        <button id="startPomodoroBtn" class="btn btn-primary">Start</button>
                        <button id="resetPomodoroBtn" class="btn btn-secondary">Reset</button>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="short-break" role="tabpanel">
                <div class="timer-container d-flex flex-column align-items-center justify-content-center">
                    <div id="short-break-timer" class="timer-display mb-4">00:00</div>
                    <div class="btn-group">
                        <button id="startShortBtn" class="btn btn-primary">Start</button>
                        <button id="resetShortBtn" class="btn btn-secondary">Reset</button>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="long-break" role="tabpanel">
                <div class="timer-container d-flex flex-column align-items-center justify-content-center">
                    <div id="long-break-timer" class="timer-display mb-4">00:00</div>
                    <div class="btn-group">
                        <button id="startLongBtn" class="btn btn-primary">Start</button>
                        <button id="resetLongBtn" class="btn btn-secondary">Reset</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model != null)
    {
        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="card mb-3 flex-fill">
                    <div class="card-body">

                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <p class="card-title mb-0">
                                Current Task
                            </p>

                            <span class="badge bg-blue-lt">
                        @Model.SelectedTask.Status
                    </span>
                        </div>

                        <input type="hidden" id="taskId" value="@Model.SelectedTask.Id"/>
                        <input type="hidden" id="taskStatus" value="@Model.SelectedTask.Status"/>

                        <!-- Title -->
                        <h5 class="mb-1">
                            @Model.SelectedTask.Title
                        </h5>

                        <!-- Description -->
                        <p class="text-muted mb-3">
                            @Model.SelectedTask.Description
                        </p>

                        <!-- Meta row -->
                        <div class="row g-2 mb-3">
                            <div class="col-auto">
                                <span class="text-secondary">Estimated</span>
                                <div class="fw-semibold">
                                    @Model.SelectedTask.EstimatedPomodoros
                                </div>
                            </div>

                            <div class="col-auto">
                                <span class="text-secondary">Completed</span>
                                <div class="fw-semibold">
                                    @Model.SelectedTask.CompletedPomodoros
                                </div>
                            </div>

                            <div class="col-auto">
                                <span class="text-secondary">Deadline</span>
                                <div class="text-muted font-monospace">
                                    @Model.SelectedTask.DueDate?.ToString("yyyy-MM-dd")
                                </div>
                            </div>
                        </div>

                        <!-- Progress -->
                        @{
                            var progress =
                                Model.SelectedTask.EstimatedPomodoros > 0
                                    ? (Model.SelectedTask.CompletedPomodoros / (double)Model.SelectedTask.EstimatedPomodoros) * 100
                                    : 0;
                        }

                        <div class="progress progress-sm mb-1">
                            <div class="progress-bar bg-blue"
                                 role="progressbar"
                                 style="width:@progress%"
                                 aria-valuenow="@progress"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>

                        <small class="text-secondary d-block mb-3">
                            @($"{progress:F0}% complete")
                        </small>

                        <!-- Action -->
                        <a asp-action="Edit"
                           asp-route-taskId="@Model.SelectedTask.Id"
                           class="btn btn-primary btn-sm">
                            Edit
                        </a>

                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script src="~/js/timer/index.js" asp-append-version="true"></script>
</body>
</html>